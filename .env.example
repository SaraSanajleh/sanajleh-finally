# ReTour AI Brain — Environment Variables (optional overrides)

RETOUR_ENVIRONMENT=development
RETOUR_DEBUG=true
RETOUR_LOG_LEVEL=INFO
RETOUR_API_PREFIX=/api/v1
RETOUR_LLM_CONFIG_PATH=config/llm.yaml
RETOUR_PROMPTS_DIRECTORY=prompts
RETOUR_PLANNER_FAST_MODE=true
RETOUR_PLANNER_FAST_POLISH=false

# Retriever (separate process; default port 8001)
RETOUR_RETRIEVER_ENABLED=true
RETOUR_RETRIEVER_BASE_URL=http://127.0.0.1:8001
RETOUR_RETRIEVER_TIMEOUT_SECONDS=120

# Data
RETOUR_SME_DATA_DIR=data/sme data
RETOUR_TOURISM_DATA_DIR=data/customized_packages/knowledge

# Context
RETOUR_WEATHER_ENABLED=true
RETOUR_WEATHER_TIMEOUT_SECONDS=8

# SME ranking
RETOUR_SME_MAX_PER_DAY=2
RETOUR_SME_MIN_MATCH_SCORE=0.35
RETOUR_SME_SUBSCRIPTION_BOOST_CAP=0.05
